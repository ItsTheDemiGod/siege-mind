{
  "name": "siege-mind",
  "version": "1.0.0",
  "description": "Siege Mind: a browser tower defense game whose enemy side is an adaptive, explainable Director AI, with a headless experiment harness.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItsTheDemiGod/siege-mind.git"
  },
  "keywords": [
    "tower-defense",
    "game",
    "canvas",
    "dynamic-difficulty-adjustment",
    "game-ai",
    "explainable-ai",
    "procedural-audio"
  ],
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "dev": "node scripts/serve.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "sim": "node experiments/run.js",
    "matchups": "node experiments/matchups.js",
    "playthrough": "node experiments/playthrough.js",
    "summarize": "node experiments/summarize.js",
    "browser-check": "node tools/browser-check/check.js",
    "smoke:browser": "node tools/browser-check/smoke.js",
    "audit": "node tools/browser-check/audit.js",
    "compare": "node experiments/directorCompare.js",
    "fixture:demo": "node experiments/makeFixture.js",
    "experiment": "node experiments/runExperimentCli.js",
    "analyze": "node experiments/analyzeCli.js",
    "calibrate": "node experiments/calibrateCli.js",
    "amendment-report": "node experiments/amendmentReport.js",
    "diagnose": "node experiments/diagnoseCli.js",
    "figures": "node experiments/figuresCli.js",
    "figures:final": "node experiments/figuresV4Cli.js",
    "results-doc": "node experiments/resultsDocCli.js",
    "early-losses": "node experiments/earlyLosses.js",
    "contrast": "node experiments/contrast.js",
    "baseline": "node experiments/makeBaseline.js",
    "first-look": "node experiments/firstLookCli.js",
    "confirm": "node experiments/confirmCli.js",
    "plan-heldout": "node experiments/heldoutPlan.js",
    "hygiene": "node tools/hygiene/scan.js"
  },
  "engines": {
    "node": ">=22"
  }
}
